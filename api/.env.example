# Copy to .env and fill in. Never commit .env.
PORT=4000

# Qloo taste API (https://hackathon.api.qloo.com, header X-Api-Key).
# Required at boot UNLESS QLOO_MOCK=true.
QLOO_API_KEY=

# QLOO_MOCK=true -> FixtureQlooClient (canned data, no key needed).
# Unset/false -> HttpQlooClient (real API, key required).
QLOO_MOCK=true

# LLM for intent extraction + itinerary assembly (FastRouter-compatible).
LLM_BASE_URL=https://api.fastrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-4.7
LLM_API_KEY=

# LLM_MOCK=true -> FixtureLLM (canned intent, no key needed).
LLM_MOCK=true
